{
  "description": "Dependency updates (docs/releasing.md, «Как сервисы получают обновления»). Keep packageRules the same as in fin-assist/go-service-template.",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Moscow",
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "fin-assist libraries and contracts/gen/go: a PR per module as soon as a version is tagged",
      "matchPackageNames": [
        "github.com/fin-assist/**"
      ],
      "schedule": [
        "at any time"
      ],
      "prPriority": 10
    },
    {
      "description": "Everything else (Go modules, GitHub Actions, images): one grouped PR a week",
      "matchPackageNames": [
        "!github.com/fin-assist/**"
      ],
      "groupName": "third-party dependencies",
      "schedule": [
        "before 9am on monday"
      ]
    },
    {
      "description": "The Go version (go and toolchain directives) is raised by hand, together with CI",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang",
        "toolchain"
      ],
      "enabled": false
    },
    {
      "description": "FIN-372: update workflow and local lint pins together; rollback together",
      "matchPackageNames": [
        "fin-assist/go-service-template",
        "fin-assist/go-service-template/**"
      ],
      "groupName": "FinAssist shared Go CI",
      "groupSlug": "finassist-shared-go-ci",
      "schedule": [
        "at any time"
      ],
      "pinDigests": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "FIN-372: keep the local shared source digest in the CI update PR",
      "managerFilePatterns": [
        "/\\.finassist-ci\\.json$/"
      ],
      "matchStrings": [
        "\"revision\"\\s*:\\s*\"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "depNameTemplate": "fin-assist/go-service-template",
      "packageNameTemplate": "fin-assist/go-service-template",
      "datasourceTemplate": "github-digest",
      "currentValueTemplate": "main"
    },
    {
      "customType": "regex",
      "description": "FIN-372: update each reusable workflow revision input with its uses pin",
      "managerFilePatterns": [
        ".github/workflows/ci.yml"
      ],
      "matchStrings": [
        "\\brevision:\\s*'(?<currentDigest>[0-9a-f]{40})'"
      ],
      "depNameTemplate": "fin-assist/go-service-template",
      "packageNameTemplate": "fin-assist/go-service-template",
      "datasourceTemplate": "github-digest",
      "currentValueTemplate": "main"
    }
  ]
}
